info (
	title: "用户服务"
	desc:  "实现用户相关功能"
)

// SendCaptcha
type SendCaptchaRequest {
	Account string `json:"account" form:"account,optional" validate:"required,min=5,max=20" msg:"required=账号不能为空，min=账号长度在5到10之间，max=账号长度在5到10之间"`
}

// LoginRequest
type LoginRequest {
	Account  string `json:"account" form:"account,optional" validate:"required" msg:"required=账号不能为空"`
	Password string `json:"password" form:"password,optional" validate:"required" msg:"required=密码不能为空"`
}

// LoginResponse
type LoginResponse {
	UserId       int64  `json:"userId"`
	Nickname     string `json:"nickName,omitempty"`
	Avatar       string `json:"avatar,omitempty"`
	Gender       int64  `json:"gender"`
	Description  string `json:"description,omitempty"`
	State        int64  `json:"state"`
	Role         int64  `json:"role"`
	Token        string `json:"token"`
	RefreshToken string `json:"refreshToken"`
	WeServiceURL string `json:"weServiceUrl"`
}

// LoginCodeRequest
type LoginCodeRequest {
	Account string `json:"account" form:"account,optional" validate:"required" msg:"required=账号不能为空"`
	Code    string `json:"code" form:"code,optional" validate:"required" msg:"验证码不能为空"`
}

// UserRegisterRequest
type UserRegisterRequest {
	Account         string `json:"account" form:"account,optional" validate:"required" msg:"required=账号不能为空"`
	Password        string `json:"password" form:"password,optional" validate:"required" msg:"required=密码不能为空"`
	ConfirmPassword string `json:"confirmPassword" form:"confirmPassword,optional" validate:"required" msg:"required=确认密码不能为空"`
	Code            string `json:"code" form:"code,optional" validate:"required" msg:"required=验证码不能为空"`
	Nickname        string `json:"nickname" form:"nickname,optional" validate:"required" msg:"required=昵称不能为空"`
}

// UserInfoResponse
type UserInfoResponse {
	UserId      int64  `json:"userId"`
	Nickname    string `json:"nickname"`
	Avatar      string `json:"avatar"`
	Description string `json:"description"`
	Account     string `json:"account"`
	Gender      int64  `json:"gender"`
}

// UserIdRequest
type UserIdRequest {
	UserId int64 `json:"userId" form:"userId,optional" validate:"required" msg:"用户ID不能为空"`
}

// UpdatePasswordRequest
type UpdatePasswordRequest {
	Account         string `json:"account" form:"account,optional" validate:"required" msg:"required=账号不能为空"`
	Password        string `json:"password" form:"password,optional" validate:"required" msg:"密码不能为空"`
	ConfirmPassword string `json:"confirmPassword" form:"confirmPassword,optional" validate:"required" msg:"确认密码不能为空"`
	Code            string `json:"code" form:"code,optional" validate:"required" msg:"验证码不能为空"`
}

// GetUploadURLRequest
type GetUploadURLRequest {
	FileName string `json:"fileName,optional" form:"fileName,optional" validate:"required" msg:"required=文件名不能为空"`
}

// UploadURLResponse
type UploadURLResponse {
	UpLoadURL   string `json:"uploadUrl"`
	DownLoadURL string `json:"downloadUrl"`
}

// UpdateAvatarRequest
type UpdateAvatarRequest {
	Url    string `json:"url" form:"url,optional" validate:"required" msg:"required=url不能为空"`
	UserId int64  `json:"userId" form:"userId,optional" validate:"required" msg:"required=用户ID不能为空"`
}

// UserIdPathRequest
type UserIdPathRequest {
	UserId string `json:"userId" form:"userId,optional" validate:"required" msg:"required=用户ID不能为空"`
}

// BalanceDetailRequest
type BalanceDetailRequest {
	UserId   string `json:"userId" form:"userId,optional" validate:"required" msg:"required=用户ID不能为空"`
	PageNum  int64 `json:"pageNum,default=1" form:"pageNum,default=1"`
	PageSize int64 `json:"pageSize,default=20,range=[1:100]" form:"pageSize,default=20,range=[1:100]"`
}

// RefreshTokenRequest
type RefreshTokenRequest {
	RefreshToken string `json:"refreshToken"`
}

@server (
	prefix:  /api/user
	group:   user
	timeout: 10s
)
service user-api {
	@handler captcha
	get /captcha (SendCaptchaRequest) returns (string)

	@handler loginPassword // 密码登录
	post /loginPassword (LoginRequest) returns (LoginResponse)

	@handler loginCode // 验证码登录
	post /loginCode (LoginCodeRequest) returns (LoginResponse)

	@handler register // 用户注册
	post /register (UserRegisterRequest) returns (LoginResponse)

	@handler logout // 退出登录
	post /logout (UserIdRequest)

	@handler userInfo // 获取用户信息
	get /user/info (UserIdRequest) returns (UserInfoResponse)

	@handler updatePassword // 更新用户密码
	post /updatePassword (UpdatePasswordRequest)

	@handler refreshUri
	get /refreshUri (UserIdRequest)

	@handler getUploadUrl //生成MinIO预签名上传URL和拼接下载URL
	get /UploadUrl (GetUploadURLRequest) returns (UploadURLResponse)

	@handler updateAvatar
	post /avatar (UpdateAvatarRequest)

	@handler getUserBalance
	get /balance/:userId (UserIdPathRequest)

	@handler getBalanceDetail
	get /balance/detail/:userId (BalanceDetailRequest)

	@handler refreshToken
	post /auth/refresh (RefreshTokenRequest) returns (string)
}
